# Generate with: openssl rand -hex 32
VIDEOSIM_PROXY_SHARED_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL and NATS credentials. Use URL-safe values because the production
# Compose file constructs connection URLs from them.
POSTGRES_DB=videosim
POSTGRES_USER=videosim
# Owner/migration password. Do not use this for application services.
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
# Non-owner service roles. All three must be distinct and URL-safe
# (A-Za-z0-9._~-); never use the owner/migration password here.
POSTGRES_APP_PASSWORD=replace-with-a-different-url-safe-random-password
POSTGRES_PUBLISHER_PASSWORD=replace-with-another-url-safe-random-password
POSTGRES_PRUNER_PASSWORD=replace-with-yet-another-url-safe-random-password
NATS_USER=videosim
NATS_PASSWORD=replace-with-a-url-safe-random-password
VIDEOSIM_DB_POOL_MIN=1
VIDEOSIM_DB_POOL_MAX=10
# Six missed heartbeats fit below the F5 45-second p95 authority-recovery gate.
VIDEOSIM_WORKER_FRESHNESS_SECONDS=30
VIDEOSIM_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
# Direct PostgreSQL monitor projection retention and repeat cadence.
VIDEOSIM_ALARM_REPEAT_SECONDS=5
VIDEOSIM_ALARM_EVENT_HISTORY_LIMIT=1000
VIDEOSIM_ALARM_EVENT_RETENTION_SECONDS=604800
VIDEOSIM_MONITOR_HISTORY_PRUNE_INTERVAL_SECONDS=3600
# Encrypted worker report spool quota. The worker key is mounted from
# deploy/certs/worker-spool.key and must be mode 0600.
VIDEOSIM_WORKER_SPOOL_MAX_BYTES=536870912

# OIDC provider registration
OIDC_ISSUER_URL=https://identity.example.com/realms/videosim
OIDC_CLIENT_ID=videosim
OIDC_CLIENT_SECRET=replace-me
# Generate according to oauth2-proxy documentation, e.g. 32 random bytes base64 encoded.
OIDC_COOKIE_SECRET=replace-me
OIDC_EMAIL_DOMAINS=*
VIDEOSIM_OPERATOR_URL=https://videosim.example.com:8443

VIDEOSIM_OPERATOR_PORT=8443
VIDEOSIM_WORKER_PORT=9443
VIDEOSIM_VIEWER_GROUP=videosim-viewer
VIDEOSIM_ADMIN_GROUP=videosim-admin

# Private destinations are denied in trusted-proxy mode unless one of these
# explicit policies is set. Prefer suffix allowlists plus VM firewall rules.
VIDEOSIM_ALLOW_PRIVATE_FEEDS=0
VIDEOSIM_ALLOWED_FEED_HOST_SUFFIXES=.media.example.com
