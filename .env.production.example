# Generate with: openssl rand -hex 32
VIDEOSIM_PROXY_SHARED_SECRET=replace-with-at-least-32-random-characters

# OIDC provider registration
OIDC_ISSUER_URL=https://identity.example.com/realms/videosim
OIDC_CLIENT_ID=videosim
OIDC_CLIENT_SECRET=replace-me
# Generate according to oauth2-proxy documentation, e.g. 32 random bytes base64 encoded.
OIDC_COOKIE_SECRET=replace-me
OIDC_EMAIL_DOMAINS=*
VIDEOSIM_OPERATOR_URL=https://videosim.example.com:8443

VIDEOSIM_OPERATOR_PORT=8443
VIDEOSIM_WORKER_PORT=9443
VIDEOSIM_VIEWER_GROUP=videosim-viewer
VIDEOSIM_ADMIN_GROUP=videosim-admin

# Private destinations are denied in trusted-proxy mode unless one of these
# explicit policies is set. Prefer suffix allowlists plus VM firewall rules.
VIDEOSIM_ALLOW_PRIVATE_FEEDS=0
VIDEOSIM_ALLOWED_FEED_HOST_SUFFIXES=.media.example.com
