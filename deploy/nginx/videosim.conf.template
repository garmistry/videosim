limit_req_zone $binary_remote_addr zone=videosim_operator:10m rate=20r/s;
limit_req_zone $ssl_client_s_dn zone=videosim_worker:10m rate=50r/s;

map $ssl_client_s_dn $videosim_worker_id {
    default "";
    ~(^|,)CN=(?<worker_common_name>[^,]+) $worker_common_name;
}

upstream videosim_app {
    server app:8080;
    keepalive 32;
}

upstream videosim_oauth {
    server oauth2-proxy:4180;
    keepalive 8;
}

server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate /etc/videosim/certs/server.crt;
    ssl_certificate_key /etc/videosim/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;

    location = /oauth2/auth {
        internal;
        proxy_pass http://videosim_oauth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /oauth2/ {
        proxy_pass http://videosim_oauth;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Auth-Request-Redirect $scheme://$host:$server_port$request_uri;
    }

    location = /healthz {
        proxy_pass http://videosim_app/healthz;
    }

    location / {
        limit_req zone=videosim_operator burst=40 nodelay;
        auth_request /oauth2/auth;
        error_page 401 = /oauth2/start?rd=$scheme://$host:$server_port$request_uri;

        auth_request_set $videosim_user $upstream_http_x_auth_request_user;
        auth_request_set $videosim_groups $upstream_http_x_auth_request_groups;

        proxy_set_header X-VideoSim-Proxy-Secret "${VIDEOSIM_PROXY_SHARED_SECRET}";
        proxy_set_header X-VideoSim-User $videosim_user;
        proxy_set_header X-VideoSim-Groups $videosim_groups;
        proxy_set_header X-VideoSim-Expected-Origin $scheme://$http_host;
        proxy_set_header X-VideoSim-Worker-ID "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Host $http_host;
        proxy_pass http://videosim_app;
    }
}

server {
    listen 9443 ssl;
    server_name _;

    ssl_certificate /etc/videosim/certs/server.crt;
    ssl_certificate_key /etc/videosim/certs/server.key;
    ssl_client_certificate /etc/videosim/certs/worker-ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 2;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;

    location = /healthz {
        proxy_pass http://videosim_app/healthz;
    }

    location /api/workers/ {
        limit_req zone=videosim_worker burst=100 nodelay;
        proxy_set_header X-VideoSim-Proxy-Secret "${VIDEOSIM_PROXY_SHARED_SECRET}";
        proxy_set_header X-VideoSim-Worker-ID $videosim_worker_id;
        proxy_set_header X-VideoSim-User "";
        proxy_set_header X-VideoSim-Groups "";
        proxy_set_header X-VideoSim-Expected-Origin "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Host $http_host;
        proxy_pass http://videosim_app;
    }

    location /dash/ {
        limit_req zone=videosim_worker burst=100 nodelay;
        proxy_set_header X-VideoSim-Proxy-Secret "${VIDEOSIM_PROXY_SHARED_SECRET}";
        proxy_set_header X-VideoSim-Worker-ID $videosim_worker_id;
        proxy_set_header X-VideoSim-User "";
        proxy_set_header X-VideoSim-Groups "";
        proxy_set_header X-VideoSim-Expected-Origin "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Host $http_host;
        proxy_pass http://videosim_app;
    }

    location / {
        return 404;
    }
}
